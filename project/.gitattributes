# Normalize line endings to LF so Windows and Linux checkouts match
# (Docker builds, shell commands, and generated datasets stay byte-identical)
* text=auto eol=lf

# Datasets are compared and loaded as-is; keep them LF
*.csv text eol=lf

# Generated by uv; collapse in diffs and language stats
uv.lock text eol=lf linguist-generated=true

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
