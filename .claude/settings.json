{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Bash(bun install)",
      "Bash(bun run *)",
      "Bash(bunx *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(curl *)",
      "Bash(powershell *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git pull *)"
    ]
  }
}