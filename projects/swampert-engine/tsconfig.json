{
  "include": [
    "source/**/*",
    "drizzle/**/*",
    "testing/**/*",
    "**.config.ts",
  ],
  "compilerOptions": {
    // Environment - Latest JavaScript features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",

    // Bundler mode - Modern module resolution for Bun
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Type checking - Strict mode enabled
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // Bun runtime types
    "types": ["@types/bun"],

    // Best practices - Additional safety checks
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Module resolution - Support for absolute imports
    "paths": {
      "@secrets": ["./source/cmd/secrets.ts"],

      "@customs/*": ["./drizzle/customs/*"],
      "@database/*": ["./drizzle/database/*"],
      "@elements/*": ["./drizzle/elements/*"],

      "@helpers/*": ["./source/infra/helpers/*"],
    },
  },
}