# ==========================================
# Application
# ==========================================
APP_PORT=3000
APP_VERSION="1.0.0"
APP_NAME="Swampert API"
APP_DOMAIN="api.swampert.com"
APP_AUDIENCE="swampert.com"

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_SAMPLER_USERNAME="sampler"
POSTGRES_SAMPLER_PASSWORD="<secure_password>"
POSTGRES_SAMPLER_URL="postgresql://sampler:<secure_password>@localhost:5432/swampert"

POSTGRES_RUNNER_USERNAME="runner"
POSTGRES_RUNNER_PASSWORD="<secure_password>"
POSTGRES_RUNNER_URL="postgresql://runner:<secure_password>@localhost:5432/swampert"

# ==========================================
# Security
# ==========================================
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT (restful.spec.md)
JWT_SECRET=
JWT_EXPIRES_IN=1h
