meta {
  name: Table History
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/audit/{{table}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Backs trace.fn_table_history. IMPORTANT: `table` must be the BARE table
  name (e.g. "tasks", "executions", "swarms", "users") — NOT schema-qualified
  ("core.tasks"). A qualified name doesn't error, it silently returns [].
}
