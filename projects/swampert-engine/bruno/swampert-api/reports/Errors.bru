meta {
  name: Errors
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/reports/errors
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~period: 2026-08-01
}

docs {
  Reads reports.error_summary for the logged-in tenant. `period` query param
  is optional (disabled by default here — enable it to filter to one month).
}
