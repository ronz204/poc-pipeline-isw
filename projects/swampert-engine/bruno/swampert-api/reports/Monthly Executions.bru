meta {
  name: Monthly Executions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reports/monthly-executions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~period: 2026-08-01
}

docs {
  Reads reports.monthly_execution_summary for the logged-in tenant. `period`
  is optional (disabled by default here, so this returns every period on
  record for the tenant).

  If you enable the `period` param: not every tenant has data in every
  month — a given (tenant, period) pair can legitimately return [] if that
  tenant had no executions that month. Run this with no filter first to see
  which periods actually have data for your logged-in tenant before
  filtering to one.
}
